# NO guardes aquí la clave del proveedor. Para secretos usa:  python -m vera --guardar-secretos
# (quedan cifrados para tu cuenta de Windows, fuera del repositorio y de OneDrive).
# Este archivo solo sirve para opciones NO secretas. Cópialo como .env si quieres cambiarlas.
VERA_PUERTO=0                  # 0 = el sistema elige un puerto libre local
VERA_CACHE_MB=50               # tamaño máximo de la caché de audio
